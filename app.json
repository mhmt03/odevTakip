{
  "expo": {
    "name": "Sınıf Takip",
    "slug": "sinif-takip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "siniftakip",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gunnermg.siniftakip",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.gunnermg.siniftakip",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "be87ea57-aebc-4b44-b01e-0e1b52130f87"
      }
    },
    "owner": "gunnermg"
  }
}
